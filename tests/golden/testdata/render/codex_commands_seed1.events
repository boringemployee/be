welcome "Codecks CLI"
prompt "›"
echo "help"
notice ""
    "Commands:"
    "  run <topic>   work on tasks for a topic"
    "  run a b c     work across several topics"
    "  topics        list topics"
    "  help          show this help"
    "  exit          leave the session"
    "Keys:"
    "  Esc           stop the current task"
    "  Ctrl+C        exit"
prompt "›"
echo "topics"
notice ""
    "Topics:"
    "  sample         Fixed topic for rendering tests"
prompt "›"
echo "run"
error "usage: run <topic> [topic...]"
notice ""
    "Topics:"
    "  sample         Fixed topic for rendering tests"
prompt "›"
echo "run nope"
error "unknown topic \"nope\""
notice ""
    "Topics:"
    "  sample         Fixed topic for rendering tests"
prompt "›"
echo "hello"
notice ""
    "Start a task with: run <topic>"
    "Type 'topics' to list topics or 'help' for commands."
prompt "›"
echo "exit"
exit ""
