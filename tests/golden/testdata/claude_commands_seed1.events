welcome "Clock Code"
prompt "❯"
echo "help"
notice ""
    "Commands:"
    "  run <topic>   pretend to work on a topic, forever"
    "  topics        list topics"
    "  help          show this help"
    "  exit          leave the session"
    "Keys:"
    "  Esc           stop the current task"
    "  Ctrl+C        exit"
prompt "❯"
echo "topics"
notice ""
    "Topics:"
    "  engineering    Refactors, bug fixes and flaky tests"
prompt "❯"
echo "run"
error "usage: run <topic>"
notice ""
    "Topics:"
    "  engineering    Refactors, bug fixes and flaky tests"
prompt "❯"
echo "run nope"
error "unknown topic \"nope\""
notice ""
    "Topics:"
    "  engineering    Refactors, bug fixes and flaky tests"
prompt "❯"
echo "hello"
notice ""
    "I'd love to help with that, but I only pretend to work."
    "Try: run <topic>   (type 'topics' to see them)"
prompt "❯"
echo "exit"
exit ""
