welcome "Clock Code"
prompt "❯"
echo "help"
notice ""
    "Commands:"
    "  run <topic>   work on tasks for a topic"
    "  run a b c     work across several topics"
    "  topics        list topics"
    "  help          show this help"
    "  exit          leave the session"
    "Keys:"
    "  Esc           stop the current task"
    "  Ctrl+C        exit"
prompt "❯"
echo "topics"
notice ""
    "Topics:"
    "  data           Pipelines, models and data quality"
    "  devops         Pipelines, infrastructure and deployments"
    "  docs           Guides, API references and runbooks"
    "  engineering    Refactors, bug fixes and flaky tests"
    "  finance        Month-end close, reconciliations and forecasts"
    "  frontend       Components, styling and accessibility"
    "  office         Spreadsheets, documents and slide decks"
    "  qa             Test plans, end-to-end suites and bug triage"
    "  security       Audits, patches and hardening"
prompt "❯"
echo "run"
error "usage: run <topic> [topic...]"
notice ""
    "Topics:"
    "  data           Pipelines, models and data quality"
    "  devops         Pipelines, infrastructure and deployments"
    "  docs           Guides, API references and runbooks"
    "  engineering    Refactors, bug fixes and flaky tests"
    "  finance        Month-end close, reconciliations and forecasts"
    "  frontend       Components, styling and accessibility"
    "  office         Spreadsheets, documents and slide decks"
    "  qa             Test plans, end-to-end suites and bug triage"
    "  security       Audits, patches and hardening"
prompt "❯"
echo "run nope"
error "unknown topic \"nope\""
notice ""
    "Topics:"
    "  data           Pipelines, models and data quality"
    "  devops         Pipelines, infrastructure and deployments"
    "  docs           Guides, API references and runbooks"
    "  engineering    Refactors, bug fixes and flaky tests"
    "  finance        Month-end close, reconciliations and forecasts"
    "  frontend       Components, styling and accessibility"
    "  office         Spreadsheets, documents and slide decks"
    "  qa             Test plans, end-to-end suites and bug triage"
    "  security       Audits, patches and hardening"
prompt "❯"
echo "hello"
notice ""
    "Start a task with: run <topic>"
    "Type 'topics' to list topics or 'help' for commands."
prompt "❯"
echo "exit"
exit ""
