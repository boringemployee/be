read "models/marts/fct_orders.sql"
thinking "Double-checking"
edit "models/marts/fct_orders.sql"
    135 "-JOIN payments USING (order_id)"
    135 "+LEFT JOIN payments USING (order_id)"
    142 "+-- grain: one row per order"
command "dbt run --select orders"
    "warning: 2 rows with null customer_id"
