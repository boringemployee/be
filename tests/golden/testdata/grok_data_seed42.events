    201 "-start = datetime.now()"
    201 "+start = datetime.now(timezone.utc)"
    241 "-schedule=\"@daily\","
    241 "+schedule=\"0 3 * * *\","
command "pytest tests/pipelines"
    "6 passed in 2.10s"
    "freshness: OK (12 minutes)"
    "PASS test_no_duplicate_orders"
