    247 "+Downside: churn +2pp, new bookings -25%"
    282 "-Growth rate: 22%"
    282 "+Growth rate: 18%"
command "python fpa/check_model.py fpa/scenarios.xlsx"
    "hard-coded numbers in formulas: 0"
    "assumptions referenced: 42/42"
    "model checks passed"
    ok=true
task_done "Finished. The change is small and focused; no behavior changes outside this module."
task_start "Update the headcount assumptions in fpa/headcount_plan.xlsx"
