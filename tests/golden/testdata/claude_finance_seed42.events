edit "fpa/headcount_plan.xlsx"
    90 "-Hires in Q1: 6"
    90 "+Hires in Q1: 4 (2 moved to Q2)"
command "python fpa/run_forecast.py --scenario base"
    "loading assumptions (42 drivers)"
