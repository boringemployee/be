    130 "+Downside: churn +2pp, new bookings -25%"
command "python fpa/check_model.py fpa/forecast_2027.xlsx"
    "hard-coded numbers in formulas: 7"
    "  Forecast!H14 uses 1.08 instead of Assumptions!C3"
    "assumptions referenced: 39/42 (3 unused)"
    "model checks failed"
    ok=false
thinking "Cogitating"
edit "fpa/forecast_2027.xlsx"
    242 "-=H13*1.08"
    242 "+=H13*(1+Assumptions!$C$3)"
command "python fpa/check_model.py fpa/forecast_2027.xlsx"
    "hard-coded numbers in formulas: 0"
    "assumptions referenced: 42/42"
    "model checks passed"
    ok=true
