    219 "+Cost center 410 Engineering: 61%, 420 Sales: 24%, 430 G&A: 15%"
    235 "+Downside: churn +2pp, new bookings -25%"
command "python fpa/run_forecast.py --scenario downside"
    "loading assumptions (42 drivers, 6 overridden)"
    "revenue 2027:   13.9M (+0% YoY)"
    "ending cash:     6.2M"
    "runway: 22 months"
    ok=true
task_done "All set. Moving on to the next item."
task_start "Split the cash-forecast budget by cost center"
