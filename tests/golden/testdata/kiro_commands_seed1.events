welcome "Kiwi CLI"
prompt ">"
echo "help"
notice ""
    "Commands:"
    "  run <topic>   pretend to work on a topic, forever"
    "  topics        list topics"
    "  help          show this help"
    "  exit          leave the session"
    "Keys:"
    "  Esc           stop the current task"
    "  Ctrl+C        exit"
prompt ">"
echo "topics"
notice ""
    "Topics:"
    "  data           Pipelines, dashboards and suspicious numbers"
    "  devops         Pipelines, infrastructure and on-call heroics"
    "  engineering    Refactors, bug fixes and flaky tests"
    "  frontend       Components, CSS and pixel pushing"
    "  security       Audits, patches and stern warnings"
prompt ">"
echo "run"
error "usage: run <topic>"
notice ""
    "Topics:"
    "  data           Pipelines, dashboards and suspicious numbers"
    "  devops         Pipelines, infrastructure and on-call heroics"
    "  engineering    Refactors, bug fixes and flaky tests"
    "  frontend       Components, CSS and pixel pushing"
    "  security       Audits, patches and stern warnings"
prompt ">"
echo "run nope"
error "unknown topic \"nope\""
notice ""
    "Topics:"
    "  data           Pipelines, dashboards and suspicious numbers"
    "  devops         Pipelines, infrastructure and on-call heroics"
    "  engineering    Refactors, bug fixes and flaky tests"
    "  frontend       Components, CSS and pixel pushing"
    "  security       Audits, patches and stern warnings"
prompt ">"
echo "hello"
notice ""
    "I'd love to help with that, but I only pretend to work."
    "Try: run <topic>   (type 'topics' to see them)"
prompt ">"
echo "exit"
exit ""
